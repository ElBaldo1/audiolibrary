{
  "name": "audiolibrary",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm start --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "format": "npm run format --workspace frontend",
    "prettier:check": "npm run prettier:check --workspace frontend",
    "test:backend": "cd backend && ./mvnw verify",
    "start:backend": "cd backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev"
  },
  "devDependencies": {
    "jsdom": "^27.4.0"
  }
}
